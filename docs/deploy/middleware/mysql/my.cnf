[mysqld]

# ---------- 字符集 ----------
# utf8mb4 是唯一正确的选择：utf8（即 utf8mb3）存不了 emoji 和部分汉字组合，
# agent 输出中出现这些的概率不低。
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci

# ---------- 时区 ----------
# 显式写死，不依赖宿主机时区。JDBC 连接串也设置了 serverTimezone=Asia/Shanghai，
# 两边一致才不会出现写入时间差 8 小时。
default-time-zone = '+08:00'

# ---------- InnoDB ----------
# 按机器内存调整：
#     2G 内存 → 256M
#     4G 内存 → 1G
#     8G 内存 → 2G ~ 3G
# 当前虚拟机是 8G，取 2G，给系统和 Redis 留余量。
#
# 事件表是高频追加写（append-only），缓冲池大小直接决定性能。当前数据量级下
# 2G 基本能把热数据装进内存。
innodb_buffer_pool_size = 2G

# 每次事务提交都把 redo log 刷到磁盘。事件溯源不能接受“提交了但丢了”，
# 这条决定崩溃恢复是否可信。1 是默认值，显式写出是为了表明这是有意选择。
innodb_flush_log_at_trx_commit = 1

# ---------- 连接 ----------
# 两条会话的 agent、SSE 长连接和应用连接池，200 足够。
max_connections = 200

[client]
default-character-set = utf8mb4
