[mysqld]

# ---------- 字符集 ----------
# utf8mb4 是唯一正确的选择：utf8（= utf8mb3）存不了 emoji 和部分汉字组合，
# 而 agent 的输出里出现这些的概率不低。
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci

# ---------- 时区 ----------
# 显式写死，不依赖宿主机的时区设置。JDBC 连接串里也设了 serverTimezone=Asia/Shanghai，
# 两边一致才不会出现"写入时间差 8 小时"这种经典问题。
default-time-zone = '+08:00'

# ---------- InnoDB ----------
# 【按机器内存调整】
#     2G 内存 → 256M
#     4G 内存 → 1G
#     8G 内存 → 2G ~ 3G
# 当前虚拟机的实际规格就是 8G，取 2G（不取满，给系统和 Redis 留余量）。
#
# 事件表是高频追加写（append-only），缓冲池大小直接决定它的性能。
# 我们的数据量级下，2G 基本能把热数据全装进内存。
innodb_buffer_pool_size = 2G

# 每次事务提交都刷 redo log 到磁盘。
# 事件溯源里"提交了但丢了"是不可接受的 —— 这条决定了崩溃恢复能不能信。
# 1 本来就是默认值，显式写出来是为了表明我们想过这件事，而不是碰巧拿到默认值。
innodb_flush_log_at_trx_commit = 1

# ---------- 连接 ----------
# 两条会话的 agent + SSE 长连接 + 应用连接池，200 绰绰有余。
max_connections = 200

[client]
default-character-set = utf8mb4
