<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.codeloom</groupId>
    <artifactId>codeloom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>codeloom-app</artifactId>
  <name>codeloom-app</name>
  <description>
    装配根与 Web 层：启动类、Data Source / Redis 配置、REST API、
    Spring Security、User 表的读写、统一返回体与全局异常处理。
    唯一的可执行模块。
  </description>

  <dependencies>
    <!-- 四个能力模块；domain 由它们传递引入 -->
    <dependency>
      <groupId>com.codeloom</groupId>
      <artifactId>codeloom-workspace</artifactId>
    </dependency>
    <dependency>
      <groupId>com.codeloom</groupId>
      <artifactId>codeloom-agent</artifactId>
    </dependency>
    <!--
      agent 的 test-jar：这里的接口测试要用它的假模型客户端（ScriptedLlm）。
      测试夹具的**行为**只该定义一次 —— 见 agent/pom.xml 里那段注释。
    -->
    <dependency>
      <groupId>com.codeloom</groupId>
      <artifactId>codeloom-agent</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.codeloom</groupId>
      <artifactId>codeloom-realtime</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      会话状态放 Redis，而不是留在 Tomcat 的内存里。

      理由和 fencing token、Pub/Sub 扇出是同一条：**水平扩展**。默认的内存会话意味着
      "在实例 A 登录、请求被负载均衡打到实例 B 就是 401"，那会让这个项目在讲
      "多实例下不出问题"的时候先在自己身上破一个洞。

      它只换存储、不换传输：凭据仍然是 HttpOnly 的 SameSite 会话 cookie
      （EventSource 和 WebSocket 握手都发不了自定义头，见 SecurityConfig 的注释），
      只是那个会话的内容不再只存在于某一台机器的堆里。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.session</groupId>
      <artifactId>spring-session-data-redis</artifactId>
    </dependency>

    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        application-local.yml **不能进产物**（它里面有一把 API Key；.gitignore 拦得住
        版本库，拦不住 jar）。它放在 src/main/resources 下是为了让 Spring 从 classpath
        找到它 —— 那样从**任何工作目录**启动都读得到，IDEA 的运行配置、mvn spring-boot:run、
        java -jar 都一样。

        排除必须加在 **jar 插件**上，不能加在 <resources> 上。
        这一点是实测出来的：写在 <resources> 里的话，target/classes 里也不会有它，
        于是 mvn spring-boot:run 找不到文件 —— 为了让 jar 干净而把日常开发弄坏了。
        加在这里则两边都对：target/classes 留着（本地能跑），jar 里没有（产物干净）。

        Spring Boot 的 repackage 是在这个 jar 的基础上做的，所以它也跟着干净了。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>application-local.yml</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- 只有 app 声明它，其他模块编出来是普通 jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
